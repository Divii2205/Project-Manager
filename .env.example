# Neon serverless Postgres connection string
# Format: postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Auth.js — generate via `openssl rand -base64 32` or `npx auth secret`
AUTH_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend — magic-link email provider — https://resend.com/api-keys
AUTH_RESEND_KEY=
EMAIL_FROM=Project Manager <noreply@yourdomain.com>

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
