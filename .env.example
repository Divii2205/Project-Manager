# Neon serverless Postgres connection string
# Format: postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Auth.js — generate via `openssl rand -base64 32` or `npx auth secret`
AUTH_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend — magic-link email provider — https://resend.com/api-keys
AUTH_RESEND_KEY=
EMAIL_FROM=Project Manager <noreply@yourdomain.com>

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron — required for /api/cron/deadline-reminders. Generate with `openssl rand -hex 32`.
# In production set this in Vercel project env vars; Vercel Cron will use it automatically.
CRON_SECRET=

# Optional — bumps GitHub API rate limit from 60/hr to 5000/hr for the Import flow.
# Create at https://github.com/settings/tokens (no scopes required for public repos).
GITHUB_TOKEN=
